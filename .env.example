# Copy to .env and fill in your own deployment values.
# .env is ignored by Git. Node 20.19+ can load it with --env-file=.env.
JOURNAL_ENV_ID=your-cloudbase-env-id
JOURNAL_REGION=ap-shanghai
JOURNAL_APP_URL=https://your-app.example.com/
JOURNAL_WIDGET_URL=https://your-api.example.com/api/widget/today
# Install @cloudbase/cli and use its bin/tcb absolute path.
JOURNAL_CLI_BIN=
# Optional existing server-only service_role API Key.
# Leave blank to create a project-specific key on the first backend deployment.
CLOUDBASE_API_KEY=
